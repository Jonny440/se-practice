@startuml
skinparam classAttributeIconSize 0

class Student {
    - studentId: String
    - name: String
    + viewAvailability(timeSlot): List<Room>
    + bookRoom(room: Room, startTime: DateTime, duration: Duration): Booking
    + cancelBooking(booking: Booking): void
}

class Administrator {
    - administratorId: String
    - name: String
    + blockRoom(room: Room): void
    + unblockRoom(room: Room): void
    + reviewRoomUsage(): UsageReport
}

class Room {
    - roomId: String
    - name: String
    - capacity: Integer
    - blocked: Boolean
    + isAvailable(startTime: DateTime, endTime: DateTime): Boolean
    + block(): void
    + unblock(): void
}

class Booking {
    - bookingId: String
    - startTime: DateTime
    - endTime: DateTime
    - status: BookingStatus
    + confirm(): void
    + cancel(): void
    + overlaps(other: Booking): Boolean
}

class UsageReport {
    - generatedAt: DateTime
    + getBookingCount(): Integer
}

enum BookingStatus {
    CONFIRMED
    CANCELLED
}

Student "1" -- "0..*" Booking : makes
Room "1" -- "0..*" Booking : has
Administrator ..> Room : manages
Administrator ..> UsageReport : reviews
UsageReport ..> Room : summarizes usage of

@enduml